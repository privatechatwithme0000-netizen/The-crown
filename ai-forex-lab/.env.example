# ---------------------------------------------------------------------------
# AI Forex Lab - Phase 1 environment template
# Copy to .env and fill in. NEVER commit a real .env.
# ---------------------------------------------------------------------------

# Application
APP_ENV=development
LOG_LEVEL=INFO
LOG_JSON=true

# PostgreSQL (source of truth)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=forex_lab
POSTGRES_USER=forex
POSTGRES_PASSWORD=change_me
# Optional explicit DSN override (async driver). If unset it is built from the parts above.
# DATABASE_URL=postgresql+psycopg://forex:change_me@postgres:5432/forex_lab

# Redis (cache only - never source of truth)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=

# Default research instrument / timeframe
DEFAULT_INSTRUMENT=AUD_CAD
DEFAULT_TIMEFRAME=M15
ACCOUNT_CURRENCY=USD

# OANDA v20 - PRACTICE ONLY in Phase 1
OANDA_ENV=practice
OANDA_ACCOUNT_ID=
OANDA_API_TOKEN=
OANDA_API_URL=https://api-fxpractice.oanda.com

# Execution safety. Phase 1 hard-blocks live execution; keep this false.
LIVE_EXECUTION_ENABLED=false

# MetaTrader 5 (optional secondary/demo adapter)
MT5_ENABLED=false
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# Broker-specific symbol for AUD/CAD, e.g. AUDCAD, AUDCAD.a, AUDCADm, AUDCAD.pro
MT5_AUDCAD_SYMBOL=AUDCAD
